/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

# Vite output: every name carries a content hash, so it never changes under the same URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Sounds keep fixed names: fresh for an hour, then served at once and refreshed in the background.
/audio/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Share card and icons keep fixed names too.
/og.png
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon-32.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# /model/* stays on the default (revalidate every time): the page keeps the model in Cache Storage
# under its sha256, so repeat visits make no model requests, and fixed chunk names must never pin
# an old chunk against a new manifest.
